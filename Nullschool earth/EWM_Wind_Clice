# ---------------------- 工具函数 ----------------------
def get_edge_reborn_coords(n, lon_range, lat_range, edge_width):
    """向量化生成边缘重生坐标"""
    if n <= 0:
        return np.zeros((0, 2))
    
    lon_min, lon_max = lon_range
    lat_min, lat_max = lat_range
    lon_edge_min = lon_min + edge_width
    lon_edge_max = lon_max - edge_width
    lat_edge_min = lat_min + edge_width
    lat_edge_max = lat_max - edge_width
    
    coords = np.zeros((n, 2))
    edge_type = np.random.choice(4, n)
    
    for direction in range(4):
        mask = edge_type == direction
        count = np.sum(mask)
        if count == 0:
            continue
        
        if direction == 0:  # 左边缘
            coords[mask, 0] = np.random.uniform(lon_edge_min, lon_edge_min + edge_width, count)
            coords[mask, 1] = np.random.uniform(lat_min, lat_max, count)
        elif direction == 1:  # 右边缘
            coords[mask, 0] = np.random.uniform(lon_edge_max - edge_width, lon_edge_max, count)
            coords[mask, 1] = np.random.uniform(lat_min, lat_max, count)
        elif direction == 2:  # 下边缘
            coords[mask, 0] = np.random.uniform(lon_min, lon_max, count)
            coords[mask, 1] = np.random.uniform(lat_edge_min, lat_edge_min + edge_width, count)
        else:  # 上边缘
            coords[mask, 0] = np.random.uniform(lon_min, lon_max, count)
            coords[mask, 1] = np.random.uniform(lat_edge_max - edge_width, lat_edge_max, count)
    
    return coords


def read_tiff_wind_data(u_tiff_path, v_tiff_path):
    """读取TIFF风场数据"""
    if not os.path.exists(u_tiff_path):
        raise FileNotFoundError(f"U风场TIFF文件不存在：{u_tiff_path}")
    if not os.path.exists(v_tiff_path):
        raise FileNotFoundError(f"V风场TIFF文件不存在：{v_tiff_path}")

    with rasterio.open(u_tiff_path) as src_u:
        u_data = src_u.read(1).astype(np.float64)
        transform = src_u.transform
        width = src_u.width
        height = src_u.height
        if src_u.nodata is not None:
            u_data[u_data == src_u.nodata] = 0.0

    with rasterio.open(v_tiff_path) as src_v:
        v_data = src_v.read(1).astype(np.float64)
        if src_v.width != width or src_v.height != height:
            raise ValueError(f"U/V TIFF尺寸不匹配！")
        if src_v.nodata is not None:
            v_data[v_data == src_v.nodata] = 0.0

    lon = np.linspace(transform.xoff, transform.xoff + transform.a * width, width)
    lat = np.linspace(transform.yoff, transform.yoff + transform.e * height, height)

    if lat[0] > lat[-1]:
        lat = lat[::-1]
        u_data = u_data[::-1, :]
        v_data = v_data[::-1, :]

    wind_speed = np.sqrt(u_data**2 + v_data**2)

    lon_mask = (lon >= TARGET_LON_RANGE[0]) & (lon <= TARGET_LON_RANGE[1])
    lat_mask = (lat >= TARGET_LAT_RANGE[0]) & (lat <= TARGET_LAT_RANGE[1])
    lon_crop, lat_crop = lon[lon_mask], lat[lat_mask]

    if len(lon_crop) == 0 or len(lat_crop) == 0:
        raise ValueError("裁剪后经纬度为空！")

    u_crop = u_data[lat_mask, :][:, lon_mask]
    v_crop = v_data[lat_mask, :][:, lon_mask]
    wind_speed_crop = wind_speed[lat_mask, :][:, lon_mask]

    print(f"✅ TIFF加载 | 裁剪后：{len(lon_crop)}x{len(lat_crop)} | 风速：{wind_speed_crop.min():.1f}~{wind_speed_crop.max():.1f} m/s")

    return lon_crop, lat_crop, u_crop, v_crop, wind_speed_crop


# ---------------------- 【核心】渐变线段生成函数 ----------------------
def create_trail_segments(trail, alpha):
    """
    将单个粒子轨迹转换为线段列表（带宽度和透明度渐变）
    
    Args:
        trail: 粒子轨迹 [(lon, lat), ...]
        alpha: 基础透明度
    
    Returns:
        segments: 线段列表 [[(lon1, lat1), (lon2, lat2)], ...]
        widths: 宽度列表
        alphas: 透明度列表
    """
    if len(trail) < 2:
        return [], [], []
    
    n = len(trail)
    segments = []
    widths = []
    alphas = []
    
    for j in range(n - 1):
        segments.append([(trail[j][0], trail[j][1]), 
                        (trail[j+1][0], trail[j+1][1])])
        # 从尾部到头部逐渐变粗变亮
        weight = (n - j) / n
        width = 0 + 0.8 * weight
        al = alpha * (1.0 - 0.1 * weight)
        widths.append(max(0.01, width))  # 防止宽度为0
        alphas.append(max(0.01, al))     # 防止透明度为0
    
    return segments, widths, alphas


# ---------------------- 【核心】风场粒子系统 ----------------------
class WindParticleSystem:
    """风场粒子系统 - 高性能版本"""
    
    def __init__(self, lon, lat, u, v, wind_speed):
        self.lon = lon
        self.lat = lat
        self.u = u
        self.v = v
        self.wind_min = wind_speed.min()
        self.wind_max = wind_speed.max()
        
        # 预创建插值函数（只创建一次）
        self.u_interp = RegularGridInterpolator(
            (lat, lon), u, bounds_error=False, fill_value=0.0, method='linear'
        )
        self.v_interp = RegularGridInterpolator(
            (lat, lon), v, bounds_error=False, fill_value=0.0, method='linear'
        )
        self.wind_interp = RegularGridInterpolator(
            (lat, lon), wind_speed, bounds_error=False, fill_value=0.0, method='linear'
        )
        
        # 粒子系统状态（固定数量）
        self.particles = np.column_stack([
            np.random.uniform(TARGET_LON_RANGE[0], TARGET_LON_RANGE[1], PARTICLE_NUM),
            np.random.uniform(TARGET_LAT_RANGE[0], TARGET_LAT_RANGE[1], PARTICLE_NUM)
        ]).astype(np.float64)
        
        # 尾流缓冲区：初始化为 NaN 以剔除无效点
        self.trail_buffer = np.full((PARTICLE_NUM, TRAIL_LENGTH, 2), np.nan, dtype=np.float64)
        self.trail_buffer[:, 0, :] = self.particles
        self.trail_head = 0
        
        # 预计算透明度
        self._update_particle_alpha()
        self.trail_alphas_base = np.linspace(1.0, 0.1, TRAIL_LENGTH)
    
    def _update_particle_alpha(self):
        """更新粒子透明度"""
        pts = self.particles[:, [1, 0]]
        wind = self.wind_interp(pts)
        wind_norm = (wind - self.wind_min) / (self.wind_max - self.wind_min + 1e-8)
        self.particle_alpha = np.clip(
            MIN_WIND_ALPHA + (MAX_WIND_ALPHA - MIN_WIND_ALPHA) * wind_norm,
            0, 1
        )
    
    def step(self):
        """前进一个时间步"""
        # 处理NaN/卡死粒子
        nan_mask = np.isnan(self.particles).any(axis=1)
        if np.any(nan_mask):
            n_reborn = np.sum(nan_mask)
            self.particles[nan_mask] = get_edge_reborn_coords(
                n_reborn, TARGET_LON_RANGE, TARGET_LAT_RANGE, EDGE_REBORN_WIDTH
            )
            # 【关键修复】将重生粒子的历史轨迹清空，防止出现瞬移连线
            self.trail_buffer[nan_mask, :, :] = np.nan
            self._update_particle_alpha()

        pts = self.particles[:, [1, 0]]
        u_p = self.u_interp(pts)
        v_p = self.v_interp(pts)
        
        self.particles[:, 0] += u_p * VELOCITY_SCALE
        self.particles[:, 1] += v_p * VELOCITY_SCALE
        
        # 边界处理
        out_lon = (self.particles[:, 0] < TARGET_LON_RANGE[0]) | (self.particles[:, 0] > TARGET_LON_RANGE[1])
        out_lat = (self.particles[:, 1] < TARGET_LAT_RANGE[0]) | (self.particles[:, 1] > TARGET_LAT_RANGE[1])
        out_bounds = out_lon | out_lat
        
        if np.any(out_bounds):
            n_reborn = np.sum(out_bounds)
            reborn_coords = get_edge_reborn_coords(
                n_reborn, TARGET_LON_RANGE, TARGET_LAT_RANGE, EDGE_REBORN_WIDTH
            )
            self.particles[out_bounds] = reborn_coords
            # 【关键修复】将出界粒子的历史轨迹清空，防止重生时产生直线
            self.trail_buffer[out_bounds, :, :] = np.nan
            
            reborn_pts = reborn_coords[:, [1, 0]]
            reborn_wind = self.wind_interp(reborn_pts)
            reborn_norm = (reborn_wind - self.wind_min) / (self.wind_max - self.wind_min + 1e-8)
            self.particle_alpha[out_bounds] = np.clip(
                MIN_WIND_ALPHA + (MAX_WIND_ALPHA - MIN_WIND_ALPHA) * reborn_norm,
                0, 1
            )
        
        # 循环缓冲区更新
        self.trail_head = (self.trail_head - 1) % TRAIL_LENGTH
        self.trail_buffer[:, self.trail_head, :] = self.particles
    
    def get_trail_segments(self):
        """获取所有尾流线段，包含宽度和透明度渐变，并剔除瞬移直线"""
        # 将循环缓冲区恢复为按时间顺序排列
        order_indices = [(self.trail_head + i) % TRAIL_LENGTH for i in range(TRAIL_LENGTH)]
        ordered_trails = self.trail_buffer[:, order_indices, :]
        
        all_segments = []
        all_widths = []
        all_colors = []  # 使用RGBA颜色代替alphas
        
        # 遍历每个粒子
        for i in range(PARTICLE_NUM):
            trail = ordered_trails[i]
            
            # 剔除无效点 (NaN)
            valid_mask = ~np.isnan(trail).any(axis=1)
            valid_trail = trail[valid_mask]
            
            if len(valid_trail) < 2:
                continue
            
            # 剔除瞬移长直线（出界重生引起）
            # 计算两点距离
            dist = np.sqrt(((valid_trail[1:] - valid_trail[:-1]) ** 2).sum(axis=1))
            # 保留距离小于阈值的点（根据你的需求调整阈值，建议2.0）
            keep_mask = np.concatenate(([True], dist < 2.0))  # 第一个点保留
            valid_trail = valid_trail[keep_mask]
            
            if len(valid_trail) < 2:
                continue
            
            # 调用你提供的渐变函数
            base_alpha = self.particle_alpha[i] * STREAM_ALPHA
            segments, widths, alphas = create_trail_segments(valid_trail, base_alpha)
            
            if not segments:
                continue
            
            all_segments.extend(segments)
            all_widths.extend(widths)
            
            # 转换为RGBA颜色（白色线条）
            for al in alphas:
                all_colors.append((1.0, 1.0, 1.0, al))
        
        if not all_segments:
            return np.zeros((0, 2, 2)), np.zeros((0,)), np.zeros((0, 4))
            
        return np.array(all_segments), np.array(all_widths), np.array(all_colors)


# ---------------------- 初始化 ----------------------
def init_all():
    """初始化画布和粒子系统"""
    lon, lat, u, v, wind_speed = read_tiff_wind_data(U_TIFF_PATH, V_TIFF_PATH)
    
    # 创建粒子系统
    particle_system = WindParticleSystem(lon, lat, u, v, wind_speed)
    
    # 色阶插值（如果需要）
    wind_speed_interp = None
    lon_interp_grid = lat_interp_grid = None
    if SHOW_COLOR_STREAM:
        lon_interp = np.linspace(TARGET_LON_RANGE[0], TARGET_LON_RANGE[1], INTERP_RESOLUTION)
        lat_interp = np.linspace(TARGET_LAT_RANGE[0], TARGET_LAT_RANGE[1], INTERP_RESOLUTION)
        lon_interp_grid, lat_interp_grid = np.meshgrid(lon_interp, lat_interp)
        lon_grid, lat_grid = np.meshgrid(lon, lat)
        points = np.vstack((lon_grid.flatten(), lat_grid.flatten())).T
        wind_speed_interp = griddata(
            points, wind_speed.flatten(), 
            (lon_interp_grid, lat_interp_grid),
            method='linear', fill_value=wind_speed.min()
        )
    
    # 画布配置
    fig = plt.figure(figsize=(40, 40), dpi=FRAME_DPI, facecolor="#00000000")
    ax = plt.axes(projection=ccrs.PlateCarree())
    ax.set_extent(TARGET_LON_RANGE + TARGET_LAT_RANGE, crs=ccrs.PlateCarree())
    ax.axis("off")
    plt.subplots_adjust(left=0, right=1, top=1, bottom=0)
    ax.set_facecolor("#00000000")
    
    # 色阶图层
    if SHOW_COLOR_STREAM and wind_speed_interp is not None:
        ax.pcolormesh(
            lon_interp_grid, lat_interp_grid, wind_speed_interp,
            cmap=REF_CMAP, 
            norm=plt.Normalize(vmin=wind_speed.min(), vmax=wind_speed.max()),
            alpha=STREAM_ALPHA, zorder=1
        )
    
    # 矢量边界
    if SHOW_BOUNDARY and os.path.exists(BOUNDARY_FILE):
        gdf = gpd.read_file(BOUNDARY_FILE)
        gdf = gdf.to_crs(ccrs.PlateCarree().proj4_init)
        gdf.plot(ax=ax, color="none", edgecolor="#FFFFFF", linewidth=0.8, zorder=2)
    
    # 使用LineCollection（支持不同线宽和颜色）
    trail_lines = LineCollection([], colors='white', linewidths=0.5, 
                                 alpha=1.0, zorder=3)
    ax.add_collection(trail_lines)
    
    os.makedirs(FRAME_ROOT_DIR, exist_ok=True)
    print(f"✅ 初始化完成 | 粒子数：{PARTICLE_NUM} | 尾流长度：{TRAIL_LENGTH}")
    
    return fig, ax, particle_system, trail_lines


# ---------------------- 帧更新 ----------------------
def update_and_save_frame(frame_idx, fig, ax, particle_system, trail_lines):
    """更新并保存一帧"""
    particle_system.step()
    
    # 获取带有渐变的线段、宽度和颜色
    segments, widths, colors = particle_system.get_trail_segments()
    
    if len(segments) > 0:
        # 设置线段、线宽和颜色（RGBA数组实现渐变）
        trail_lines.set_segments(segments)
        trail_lines.set_linewidths(widths)
        trail_lines.set_color(colors)
        
    else:
        trail_lines.set_segments([])
        trail_lines.set_linewidths([])
        trail_lines.set_color([])
    
    frame_path = os.path.join(FRAME_ROOT_DIR, f"frame_{frame_idx + 1:05d}.{FRAME_FORMAT}")
    plt.savefig(frame_path, dpi=FRAME_DPI, facecolor=fig.get_facecolor(), 
                bbox_inches='tight', pad_inches=0)
    
    return frame_path


# ---------------------- 批量生成 ----------------------
def generate_frame_series():
    """生成所有帧"""
    fig, ax, particle_system, trail_lines = init_all()
    total_frames = FPS * DURATION
    print(f"\n🚀 开始生成 | 总帧数：{total_frames} | 帧率：{FPS}")
    
    import time
    start_time = time.time()
    
    for frame_idx in range(total_frames):
        frame_path = update_and_save_frame(
            frame_idx, fig, ax, particle_system, trail_lines
        )
        
        if (frame_idx + 1) % 10 == 0:
            elapsed = time.time() - start_time
            avg_time = elapsed / (frame_idx + 1)
            remaining = avg_time * (total_frames - frame_idx - 1)
            print(f"进度：{frame_idx + 1}/{total_frames} | "
                  f"已用：{elapsed:.1f}s | 预计剩余：{remaining:.1f}s")
    
    plt.close(fig)
    total_time = time.time() - start_time
    print(f"\n🎉 生成完成！总耗时：{total_time:.1f}s | "
          f"平均每帧：{total_time/total_frames:.2f}s")
    print(f"📁 保存路径：{FRAME_ROOT_DIR}")


